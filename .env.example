# .env.example — plantilla pública sin valores reales
# Copiar a .env y completar con datos reales (NUNCA subir .env a Git)
SECRET_KEY=cambiar-por-clave-aleatoria-segura-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/erp_db

# Stripe (W14)
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_PUBLICABLE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET_AQUI

# Celery y correo (W16-W18)
CELERY_MODE=eager              # eager = sin Redis | redis = cola real
EMAIL_MODE=archivo             # archivo | gmail | sendgrid | consola
SITE_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=Catalogo <noreply@catalogo.local>
ADMIN_EMAIL=admin@tu-dominio.com
# REDIS_URL=redis://localhost:6379/0
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
# SENDGRID_API_KEY=SG.xxxxxxxx

# Media en S3 (W11, opcional)
# AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_AQUI
# AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY_AQUI
# AWS_STORAGE_BUCKET_NAME=erp-django-media
# AWS_S3_REGION_NAME=us-east-1

# .env.example — agregar:

# W17 — Correo (django-anymail + SendGrid)
# Local: EMAIL_BACKEND de consola (el correo se imprime en la terminal).
# Render: settings_prod.py usa SendGrid automáticamente si existe
#         SENDGRID_API_KEY. DEFAULT_FROM_EMAIL debe ser un Sender
#         VERIFICADO en SendGrid (Settings → Sender Authentication).
SENDGRID_API_KEY=SG.TU_CLAVE_AQUI
DEFAULT_FROM_EMAIL=ERP Django <tu-correo-verificado@dominio.com>
ADMIN_EMAIL=admin@tu-dominio.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SITE_URL=http://127.0.0.1:8000   (en Render se usa RENDER_EXTERNAL_URL)